# ─── Node.js / TypeScript ───
node_modules/
npm-debug.log*
*.tsbuildinfo

# ─── VSCode 확장 빌드 산출물 ───
dist/
out/
*.vsix

# ─── VSCode 확장 테스트 ───
.vscode-test/

# ─── Dev-only profile export artifacts (F12); real user projects commit their own ───
/devswitcher.profile.json

# ─── Rust test-fixture build output ───
src/test/fixtures/**/target/
src/test/fixtures/**/Cargo.lock

# ─── .NET test-fixture build output ───
src/test/fixtures/**/bin/
src/test/fixtures/**/obj/

# ─── Python test-fixture caches / venvs ───
src/test/fixtures/**/__pycache__/
src/test/fixtures/**/.venv/
src/test/fixtures/**/*.pyc

# ─── CMake test-fixture build output ───
src/test/fixtures/**/build/

# ─── Go test-fixture build output (go build drops the binary in the module dir) ───
src/test/fixtures/go/**/*.exe
src/test/fixtures/go/hello/hello

# ─── Member personal session logs ───
.cowork/members/*/workspace/session_logs/*.md
!.cowork/members/*/workspace/session_logs/.gitkeep

# ─── Upgrade staging area ───
.cowork/.upgrade/

# ─── OS ───
.DS_Store
Thumbs.db
