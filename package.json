{
  "name": "devswitcher-tools",
  "displayName": "DevSwitcher Tools",
  "description": "Multi-language unified status-bar UX for VSCode (Rust / C++ / C# / Python)",
  "version": "0.3.0",
  "publisher": "lim8603",
  "icon": "images/icon-256.png",
  "private": true,
  "license": "MIT",
  "author": "Seunghyun",
  "repository": {
    "type": "git",
    "url": "https://github.com/lim8603/dot-tools.git"
  },
  "bugs": {
    "url": "https://github.com/lim8603/dot-tools/issues"
  },
  "homepage": "https://github.com/lim8603/dot-tools#readme",
  "keywords": [
    "rust",
    "cargo",
    "dotnet",
    "csharp",
    "python",
    "cmake",
    "c++",
    "status bar",
    "build",
    "run",
    "debug",
    "project switcher"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/CMakeLists.txt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devSwitcher.switchProject",
        "title": "Switch Project",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.pickChip",
        "title": "Pick Chip Value",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.build",
        "title": "Build",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.run",
        "title": "Run",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.debug",
        "title": "Debug",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.openSettings",
        "title": "Open Settings",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.exportProfile",
        "title": "Export Profile",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.importProfile",
        "title": "Import Profile",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.doctor",
        "title": "Doctor (environment diagnostics)",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.rescan",
        "title": "Rescan Projects",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.newProject",
        "title": "New Project…",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.toggleCompact",
        "title": "Toggle Compact Status Bar",
        "category": "DevSwitcher"
      }
    ],
    "configuration": {
      "title": "DevSwitcher",
      "properties": {
        "devSwitcher.statusBar.compact": {
          "type": "boolean",
          "default": false,
          "description": "Show status-bar chips as icons only (hover or click for the value). Useful on narrow windows."
        },
        "devSwitcher.statusBar.selectedOnly": {
          "type": "boolean",
          "default": false,
          "description": "Show only chips that have a value; hide unselected optional chips (required chips stay visible). Default shows all chips."
        },
        "devSwitcher.cmake.debugger": {
          "type": "string",
          "enum": [
            "auto",
            "cpptools",
            "codelldb"
          ],
          "enumDescriptions": [
            "Auto-detect from the compiler (File API): MSVC → cppvsdbg, GCC → cppdbg+gdb, Clang → cppdbg+lldb (all via the C/C++ extension).",
            "Force the Microsoft C/C++ extension (cppvsdbg/cppdbg).",
            "Force CodeLLDB (lldb)."
          ],
          "default": "auto",
          "description": "Which debugger the CMake adapter uses. 'auto' picks the right one from the configured compiler; override only when you prefer a specific debugger (e.g. CodeLLDB for Clang)."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "devswitcher-rustc",
        "owner": "rust",
        "source": "rustc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(warning|error)(?:\\[(.+?)\\])?: (.+)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s+-->\\s+(.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "devSwitcher.cargo",
        "properties": {
          "action": {
            "type": "string",
            "description": "The DevSwitcher action this task runs (build or run)."
          },
          "projectId": {
            "type": "string",
            "description": "The DevSwitcher project id the task belongs to."
          }
        }
      },
      {
        "type": "devSwitcher.dotnet",
        "properties": {
          "action": {
            "type": "string",
            "description": "The DevSwitcher action this task runs (build or run)."
          },
          "projectId": {
            "type": "string",
            "description": "The DevSwitcher project id the task belongs to."
          }
        }
      },
      {
        "type": "devSwitcher.python",
        "properties": {
          "action": {
            "type": "string",
            "description": "The DevSwitcher action this task runs (run)."
          },
          "projectId": {
            "type": "string",
            "description": "The DevSwitcher project id the task belongs to."
          }
        }
      },
      {
        "type": "devSwitcher.cmake",
        "properties": {
          "action": {
            "type": "string",
            "description": "The DevSwitcher action this task runs (build)."
          },
          "projectId": {
            "type": "string",
            "description": "The DevSwitcher project id the task belongs to."
          }
        }
      },
      {
        "type": "devswitcher-buildevent",
        "properties": {
          "phase": {
            "type": "string",
            "description": "The build-event phase (pre or post)."
          }
        }
      },
      {
        "type": "devswitcher-newproject",
        "properties": {
          "language": {
            "type": "string",
            "description": "The language/adapter creating the new project."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration": "npm run compile && npm run compile-tests && vscode-test",
    "pretest": "npm run compile && npm run check-types"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.11.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.2"
  }
}
