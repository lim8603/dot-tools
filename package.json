{
  "name": "devswitcher-tools",
  "displayName": "DevSwitcher Tools",
  "description": "Multi-language unified status-bar UX for VSCode (Rust / C++ / C# / Python)",
  "version": "0.0.1",
  "publisher": "seunghyun",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/Cargo.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devSwitcher.switchProject",
        "title": "Switch Project",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.pickChip",
        "title": "Pick Chip Value",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.build",
        "title": "Build",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.run",
        "title": "Run",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.debug",
        "title": "Debug",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.openSettings",
        "title": "Open Settings",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.exportProfile",
        "title": "Export Profile",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.importProfile",
        "title": "Import Profile",
        "category": "DevSwitcher"
      },
      {
        "command": "devSwitcher.doctor",
        "title": "Doctor (environment diagnostics)",
        "category": "DevSwitcher"
      }
    ],
    "problemMatchers": [
      {
        "name": "devswitcher-rustc",
        "owner": "rust",
        "source": "rustc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(warning|error)(?:\\[(.+?)\\])?: (.+)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s+-->\\s+(.+?):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "devSwitcher.cargo",
        "properties": {
          "action": {
            "type": "string",
            "description": "The DevSwitcher action this task runs (build or run)."
          },
          "projectId": {
            "type": "string",
            "description": "The DevSwitcher project id the task belongs to."
          }
        }
      },
      {
        "type": "devswitcher-buildevent",
        "properties": {
          "phase": {
            "type": "string",
            "description": "The build-event phase (pre or post)."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration": "npm run compile && npm run compile-tests && vscode-test",
    "pretest": "npm run compile && npm run check-types"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.11.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.2"
  }
}
