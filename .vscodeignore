# ── VSIX contents ──
# Ship only: dist/extension.js, README.md, LICENSE, CHANGELOG.md, package.json,
# images/*.png. Everything else below is excluded to keep the package slim.
# (node_modules, .git, and package-lock.json are excluded by vsce defaults.)

# Source & build tooling (already bundled into dist/extension.js)
src/**
out/**
.vscode-test/**
esbuild.js
tsconfig.json
**/tsconfig.*
eslint.config.*
.eslintrc*
.vscode-test.mjs
.mocharc.json
**/*.ts
**/*.map

# AI-tool entrypoints & cowork process docs (not part of the shipped extension)
.cowork/**
docs/**
CLAUDE.md
AGENTS.md
GEMINI.md
.github/**
.claude/**

# Editor / repo config
.vscode/**
.gitignore
.gitattributes
.editorconfig
*.code-workspace

# Dev-only artifacts
devswitcher.profile.json
images/*.svg
*.vsix
release/**

# Icon masters — the extension ships images/icon-256.png (package.json "icon") only
images/icon-128.png
images/icon-512.png
images/icon-origin.png
